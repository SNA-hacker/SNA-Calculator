<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/background">

    <include
        layout="@layout/toolbar_calculator" />

    <LinearLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp"
        android:orientation="vertical"
        android:padding="25dp"
        android:background="@color/displayColor">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textSize="18sp"
            android:textColor="@color/expressionTextColor"
            />
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="36sp"
            android:textColor="@color/headingColor"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="32sp"
            android:gravity="end|center_vertical"
            />


    </LinearLayout>


    <GridLayout
        android:id="@+id/calculatorGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="12dp"
        android:columnCount="4"
        android:rowCount="6">



        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/functionButtonColor"
            android:text="AC"
            android:textColor="@color/functionTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnChangeSign"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/functionButtonColor"
            android:text="±"
            android:textColor="@color/functionTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnMod"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/functionButtonColor"
            android:text="%"
            android:textColor="@color/functionTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/operationButtonColor"
            android:text="÷"
            android:textColor="@color/operationTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber7"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="7"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber8"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="8"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber9"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="9"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="@color/operationButtonColor"
            android:text="×"
            android:textColor="@color/operationTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber4"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="4"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber5"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="5"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber6"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="6"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/operationButtonColor"
            android:text="-"
            android:textColor="@color/operationTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber1"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="1"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber2"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="2"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber3"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="3"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/operationButtonColor"
            android:text="+"
            android:textColor="@color/operationTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnNumber0"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="0"
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />



        <Button
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/numberButtonColor"
            android:text="."
            android:textColor="@color/numberTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:backgroundTint="@color/deleteButtonColor"
            android:text="⌫"
            android:textColor="@color/deleteTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnEqual"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="@color/equalsButtonColor"
            android:text="="
            android:textColor="@color/equalsTextColor"
            android:textSize="18sp"
            />

        <Button
            android:id="@+id/btnOpenBracket"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="2dp"
            android:backgroundTint="@color/functionButtonColor"
            android:text="("
            android:textColor="@color/functionTextColor"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnCloseBracket"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_margin="2dp"
            android:backgroundTint="@color/functionButtonColor"
            android:text=")"
            android:textColor="@color/functionTextColor"
            android:textSize="18sp" />







    </GridLayout>


    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Calculate anytime, anywhere, anything:)"
        android:textColor="@color/headingColor"
        android:textSize="18sp" />

    



</LinearLayout>